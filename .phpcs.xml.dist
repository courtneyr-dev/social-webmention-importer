<?xml version="1.0"?>
<ruleset name="Social Webmention Importer">
	<description>WordPress Coding Standards for Social Webmention Importer.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/tests/fixtures/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="8.2-"/>

	<rule ref="WordPress">
		<!-- Short ternaries and arrow functions are used deliberately. -->
		<exclude name="Universal.Operators.DisallowShortTernary"/>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="social-webmention-importer"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="swi_"/>
				<element value="SWI_"/>
				<element value="CourtneyRDev\SocialWebmentionImporter"/>
			</property>
		</properties>
	</rule>

	<!-- Test files may use non-WPCS class naming for PHPUnit discovery,
	     and PHPUnit test methods document themselves through their names. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<!-- The test bootstrap follows the WP test-suite convention
		     ($_tests_dir, WP_TESTS_PHPUNIT_POLYFILLS_PATH). -->
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
